ARG OCTANE_BASE_TAG=phpswoole/swoole:php{{PHP_VERSION}}-alpine
FROM ${OCTANE_BASE_TAG} AS base

ARG WWWGROUP=1000
ARG HAS_MYSQL=0
ARG HAS_POSTGRES=0
ARG HAS_MONGO=0
ARG HAS_REDIS=0
ARG HAS_MEMCACHED=0

ENV SUPERVISOR_PHP_COMMAND="/usr/local/bin/php artisan octane:start --server=swoole --host=0.0.0.0 --port=80"
ENV SUPERVISOR_PHP_USER="sail"

WORKDIR /var/www/html

RUN apk add --no-cache bash git curl supervisor \
    && if [ "$HAS_MYSQL" = "1" ]; then apk add --no-cache mysql-client; fi \
    && if [ "$HAS_POSTGRES" = "1" ]; then apk add --no-cache postgresql-client; fi \
    && apk add --no-cache --virtual .build-deps $PHPIZE_DEPS \
    && if [ "$HAS_REDIS" = "1" ]; then pecl install redis && docker-php-ext-enable redis; fi \
    && if [ "$HAS_MEMCACHED" = "1" ]; then pecl install memcached && docker-php-ext-enable memcached; fi \
    && if [ "$HAS_MONGO" = "1" ]; then pecl install mongodb && docker-php-ext-enable mongodb; fi \
    && apk del .build-deps \
    && curl -sLS https://getcomposer.org/installer | php -- --install-dir=/usr/bin/ --filename=composer \
    && ARCH="$(apk --print-arch)" \
    && case "$ARCH" in x86_64|amd64) GOSU_ARCH=amd64;; aarch64|arm64) GOSU_ARCH=arm64;; armv7) GOSU_ARCH=armhf;; *) GOSU_ARCH="$ARCH";; esac \
    && mkdir -p /usr/local/bin \
    && curl -fsSL "https://github.com/tianon/gosu/releases/download/1.17/gosu-${GOSU_ARCH}" -o /usr/local/bin/gosu \
    && chmod +x /usr/local/bin/gosu \
    && (addgroup -g ${WWWGROUP} sail 2>/dev/null || addgroup -S sail 2>/dev/null || true) \
    && adduser -D -G sail -u 1337 sail \
    && mkdir -p /etc/supervisor/conf.d

COPY php.ini /usr/local/etc/php/conf.d/99-sail.ini
COPY start-container /usr/local/bin/start-container
RUN chmod +x /usr/local/bin/start-container

EXPOSE 80
ENTRYPOINT ["start-container"]

FROM base AS development
RUN apk add --no-cache nodejs npm
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

FROM base AS production
