ARG OCTANE_BASE_TAG=dunglas/frankenphp:php{{PHP_VERSION}}
FROM ${OCTANE_BASE_TAG} AS base

ARG WWWGROUP=1000
ARG HAS_MYSQL=0
ARG HAS_POSTGRES=0
ARG HAS_MONGO=0
ARG HAS_REDIS=0
ARG HAS_MEMCACHED=0

ENV SUPERVISOR_PHP_COMMAND="/usr/local/bin/php artisan octane:frankenphp --host=0.0.0.0 --port=80"
ENV SUPERVISOR_PHP_USER="sail"

WORKDIR /var/www/html

RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl supervisor gosu \
    && if [ "$HAS_MYSQL" = "1" ]; then apt-get install -y --no-install-recommends default-mysql-client; fi \
    && if [ "$HAS_POSTGRES" = "1" ]; then apt-get install -y --no-install-recommends postgresql-client; fi \
    && if [ "$HAS_REDIS" = "1" ]; then pecl install redis && docker-php-ext-enable redis; fi \
    && if [ "$HAS_MEMCACHED" = "1" ]; then pecl install memcached && docker-php-ext-enable memcached; fi \
    && if [ "$HAS_MONGO" = "1" ]; then pecl install mongodb && docker-php-ext-enable mongodb; fi \
    && curl -sLS https://getcomposer.org/installer | php -- --install-dir=/usr/bin/ --filename=composer \
    && groupadd -g ${WWWGROUP} sail 2>/dev/null || true \
    && useradd -ms /bin/bash -u 1337 -g sail sail 2>/dev/null || true \
    && mkdir -p /etc/supervisor/conf.d \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY php.ini /usr/local/etc/php/conf.d/99-sail.ini
COPY start-container /usr/local/bin/start-container
RUN chmod +x /usr/local/bin/start-container

EXPOSE 80
ENTRYPOINT ["start-container"]

FROM base AS development
RUN apt-get update && apt-get install -y --no-install-recommends nodejs npm \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf
COPY octane/Caddyfile /etc/caddy/Caddyfile

FROM base AS production
COPY octane/Caddyfile /etc/caddy/Caddyfile
