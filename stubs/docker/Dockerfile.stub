FROM alpine:3.21 AS base

ARG WWWGROUP=1000
ARG MYSQL_CLIENT=mysql-client
ARG HAS_MYSQL=0
ARG HAS_POSTGRES=0
ARG HAS_MONGO=0
ARG HAS_REDIS=0
ARG HAS_MEMCACHED=0

ENV TZ=UTC
ENV SUPERVISOR_PHP_COMMAND="/usr/bin/php -d variables_order=EGPCS /var/www/html/artisan serve --host=0.0.0.0 --port=80"
ENV SUPERVISOR_PHP_USER="sail"

WORKDIR /var/www/html

RUN apk add --no-cache \
    bash curl git supervisor sqlite \
    {{PHP_PKG}} {{PHP_PKG}}-cli {{PHP_PKG}}-pdo \
    {{PHP_PKG}}-mbstring {{PHP_PKG}}-xml {{PHP_PKG}}-curl {{PHP_PKG}}-zip {{PHP_PKG}}-bcmath \
    {{PHP_PKG}}-intl {{PHP_PKG}}-gd {{PHP_PKG}}-opcache {{PHP_PKG}}-tokenizer \
    {{PHP_PKG}}-fileinfo {{PHP_PKG}}-ctype {{PHP_PKG}}-session {{PHP_PKG}}-dom {{PHP_PKG}}-phar \
    {{PHP_PKG}}-pcntl {{PHP_PKG}}-posix \
    && if [ "$HAS_MYSQL" = "1" ]; then apk add --no-cache ${MYSQL_CLIENT} {{PHP_PKG}}-pdo_mysql; fi \
    && if [ "$HAS_POSTGRES" = "1" ]; then apk add --no-cache postgresql-client {{PHP_PKG}}-pdo_pgsql; fi \
    && if [ "$HAS_REDIS" = "1" ]; then apk add --no-cache {{PHP_PKG}}-redis; fi \
    && if [ "$HAS_MEMCACHED" = "1" ]; then apk add --no-cache {{PHP_PKG}}-pecl-memcached memcached-dev; fi \
    && if [ "$HAS_MONGO" = "1" ]; then apk add --no-cache {{PHP_PKG}}-pecl-mongodb; fi \
    && ln -sf /usr/bin/{{PHP_PKG}} /usr/bin/php \
    && curl -sLS https://getcomposer.org/installer | php -- --install-dir=/usr/bin/ --filename=composer \
    && ARCH="$(apk --print-arch)" \
    && case "$ARCH" in x86_64|amd64) GOSU_ARCH=amd64;; aarch64|arm64) GOSU_ARCH=arm64;; armv7) GOSU_ARCH=armhf;; *) GOSU_ARCH="$ARCH";; esac \
    && mkdir -p /usr/local/bin \
    && curl -fsSL "https://github.com/tianon/gosu/releases/download/1.17/gosu-${GOSU_ARCH}" -o /usr/local/bin/gosu \
    && chmod +x /usr/local/bin/gosu \
    && (addgroup -g ${WWWGROUP} sail 2>/dev/null || addgroup -S sail 2>/dev/null || true) \
    && adduser -D -G sail -u 1337 sail \
    && mkdir -p /etc/supervisor/conf.d

COPY php.ini {{PHP_INI_PATH}}
COPY start-container /usr/local/bin/start-container
RUN chmod +x /usr/local/bin/start-container

EXPOSE 80
ENTRYPOINT ["start-container"]

FROM base AS development
RUN apk add --no-cache nodejs npm {{XDEBUG_PACKAGE}} \
    && cp /etc/supervisor/conf.d/supervisord.conf /etc/supervisor/conf.d/supervisord.conf.bak 2>/dev/null || true
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

FROM base AS production
