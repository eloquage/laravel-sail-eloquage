redis:
    image: 'redis:{{VERSION}}-alpine'
    ports:
        - '${FORWARD_REDIS_PORT:-6379}:6379'
    volumes:
        - 'sail-redis:/data'
    networks:
        - sail
    healthcheck:
        test: ["CMD", "redis-cli", "ping"]
        retries: 3
        timeout: 5s
redis-replica:
    image: 'redis:{{VERSION}}-alpine'
    command: redis-server --replicaof redis 6379
    ports:
        - '${FORWARD_REDIS_REPLICA_PORT:-6380}:6379'
    volumes:
        - 'sail-redis-replica:/data'
        - './docker/redis/replication/replica.conf:/usr/local/etc/redis/redis.conf'
    depends_on:
        - redis
    networks:
        - sail
    healthcheck:
        test: ["CMD", "redis-cli", "ping"]
        retries: 3
        timeout: 5s
