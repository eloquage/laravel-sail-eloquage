ARG OCTANE_BASE_TAG=phpswoole/swoole:php8.5-alpine
FROM ${OCTANE_BASE_TAG} AS base

ARG WWWGROUP=1000
ARG HAS_MYSQL=0
ARG HAS_POSTGRES=0
ARG HAS_MONGO=0
ARG HAS_REDIS=0
ARG HAS_MEMCACHED=0

ENV SUPERVISOR_PHP_COMMAND="/usr/local/bin/php artisan octane:start --server=swoole --host=0.0.0.0 --port=80"
ENV SUPERVISOR_PHP_USER="sail"

WORKDIR /var/www/html

RUN apk add --no-cache bash git curl supervisor gosu \
    && if [ "$HAS_MYSQL" = "1" ]; then apk add --no-cache mysql-client; fi \
    && if [ "$HAS_POSTGRES" = "1" ]; then apk add --no-cache postgresql-client; fi \
    && if [ "$HAS_REDIS" = "1" ]; then apk add --no-cache php-redis || pecl install redis; fi \
    && if [ "$HAS_MEMCACHED" = "1" ]; then apk add --no-cache php-pecl-memcached memcached-dev || pecl install memcached; fi \
    && if [ "$HAS_MONGO" = "1" ]; then apk add --no-cache php-pecl-mongodb || pecl install mongodb; fi \
    && curl -sLS https://getcomposer.org/installer | php -- --install-dir=/usr/bin/ --filename=composer \
    && addgroup -g ${WWWGROUP} sail 2>/dev/null || true \
    && adduser -D -G sail -u 1337 sail \
    && mkdir -p /etc/supervisor/conf.d

COPY php.ini /usr/local/etc/php/conf.d/99-sail.ini
COPY start-container /usr/local/bin/start-container
RUN chmod +x /usr/local/bin/start-container

EXPOSE 80
ENTRYPOINT ["start-container"]

FROM base AS development
RUN apk add --no-cache nodejs npm
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

FROM base AS production
